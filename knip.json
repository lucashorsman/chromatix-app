{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["**/*.test.ts"],
  "ignoreDependencies": ["tslib", "postcss-scss", "@vercel/blob", "node-id3", "lint-staged", "three", "@types/three"],
  "project": ["src/**/*.{ts,tsx,js,jsx}"],
  "ignore": ["**/_archived/**"],
  "rules": {
    "duplicates": "off",
    "exports": "off",
    "files": "off"
  },
  "tags": ["-lintignore"]
}
